<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <RootNamespace>Repilot</RootNamespace>
    <AssemblyName>Repilot</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <Configurations>Debug;Release</Configurations>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\Repilot.ico</ApplicationIcon>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- NuGet packages ────────────────────────────────────────────── -->
  <ItemGroup>
    <!-- System.Drawing for runtime tray-icon rendering -->
    <FrameworkReference Include="Microsoft.WindowsDesktop.App" />

    <!-- WinUI 3 (Windows App SDK) — Fluent Design, Mica, NavigationView -->
    <PackageReference Include="Microsoft.WindowsAppSDK" />

    <!-- MVVM source generators (ObservableProperty, RelayCommand) -->
    <PackageReference Include="CommunityToolkit.Mvvm" />

    <!-- Structured logging; the shared NLog.config is linked in by the kit's targets -->
    <PackageReference Include="NLog" />
  </ItemGroup>

  <!-- The shared WinUI App Kit (KIT-2). The key handler never references it: it must stay free of
       WinUI and NLog. -->
  <ItemGroup>
    <ProjectReference Include="..\external\winui-app-kit\WinUIAppKit\WinUIAppKit.csproj" />
  </ItemGroup>

  <!-- Content files to copy to output ────────────────────────────── -->
  <ItemGroup>
    <None Remove="Resources\Repilot.ico" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Resources\Repilot.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- Shared "Our other apps" cross-promo page. Bundled data is the offline
       fallback; the page refreshes its public manifest at runtime. -->
  <Import Project="..\external\promo\PromotedApps.projitems" Label="Shared" />
</Project>
