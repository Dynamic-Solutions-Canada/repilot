<Window
    x:Class="Repilot.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:kit="using:WinUIAppKit.Pages"
    Title="Repilot">
    <!-- The family's settings shell (UI-1, UI-2): title bar, navigation and the fixed footer
         ("Our other apps", About, Settings). Repilot adds its own pages in code. -->
