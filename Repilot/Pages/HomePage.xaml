<Page
    x:Class="Repilot.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel x:Name="PageContent" Style="{StaticResource PageContentStyle}">
            <TextBlock Text="Repilot" Style="{StaticResource PageTitleStyle}" />
            <TextBlock x:Uid="HomeDescription" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />

            <InfoBar x:Name="StatusBar" IsOpen="True" IsClosable="False" Margin="0,8,0,0">
                <InfoBar.ActionButton>
                    <Button x:Name="AssignButton" x:Uid="AssignInSettings" Click="AssignButton_Click" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock x:Uid="OnCopilotPress" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <FontIcon Glyph="&#xE765;" FontSize="22" VerticalAlignment="Center" />
                        <TextBlock x:Name="ActionText" Style="{StaticResource SubtitleTextBlockStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <!-- Icon-plus-label buttons take their accessible name from the label (x:Uid
                             AutomationProperties.Name), since a StackPanel gives them none. -->
                        <Button x:Name="ChangeButton" x:Uid="ChangeButton" Click="ChangeButton_Click" Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Style="{StaticResource IconLabelStyle}">
                                <FontIcon Glyph="&#xE70F;" Style="{StaticResource ButtonGlyphStyle}" />
                                <TextBlock x:Uid="ChangeAction" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="TestButton" x:Uid="TestButton" Click="TestButton_Click">
                            <StackPanel Style="{StaticResource IconLabelStyle}">
                                <FontIcon Glyph="&#xE768;" Style="{StaticResource ButtonGlyphStyle}" />
                                <TextBlock x:Uid="TestAction" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
