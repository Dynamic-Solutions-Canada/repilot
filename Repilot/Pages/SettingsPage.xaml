<Page
    x:Class="Repilot.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:l10n="using:WinUIAppKit.Localization"
    xmlns:kitc="using:WinUIAppKit.Controls">
    <ScrollViewer>
        <StackPanel Style="{StaticResource PageContentStyle}">
            <TextBlock l10n:Localize.Text="kit.settings.title" Style="{StaticResource PageTitleStyle}" />

            <TextBlock x:Uid="SettingsAppearanceHeader" Style="{StaticResource FirstSectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="12">
                    <!-- Language: options are labelled in their own language and filled in code. A change
                         applies when the settings app is reopened (Repilot's text is .resw). -->
                    <StackPanel Spacing="4">
                        <ComboBox x:Name="LanguageCombo" x:Uid="LanguageCombo" MinWidth="220"
                                  SelectionChanged="LanguageCombo_SelectionChanged" />
                        <TextBlock x:Uid="LanguageDescription" Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <kitc:ThemeSetting x:Name="ThemeRow" />
                </StackPanel>
            </Border>

            <InfoBar x:Name="LanguageRestartBar" IsOpen="False" IsClosable="False" Severity="Informational" />
            <InfoBar x:Uid="NoBackground" IsOpen="True" IsClosable="False" Severity="Informational" />

            <TextBlock x:Uid="SettingsResetHeader" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardBorderStyle}">
                <kitc:ResetSetting x:Name="ResetRow" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
