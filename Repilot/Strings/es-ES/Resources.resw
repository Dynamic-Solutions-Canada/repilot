  <data name="AboutDescription" xml:space="preserve">
    <value>Elige qué hace la tecla Copilot de tu teclado: enviar un atajo personalizado, escribir texto, abrir una aplicación o enlace, o ejecutar una función de Windows.</value>
  </data>
  <data name="HowItWorks" xml:space="preserve">
