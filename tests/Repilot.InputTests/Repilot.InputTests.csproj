<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Compile Include="../../Repilot/Models/*.cs" Link="Shared/%(Filename)%(Extension)" />
    <Compile Include="../../Repilot/Services/ActionExecutor.cs" Link="Shared/ActionExecutor.cs" />
    <Compile Include="../../Repilot/Services/ActionSummary.cs" Link="Shared/ActionSummary.cs" />
    <Compile Include="../../Repilot/Services/WindowsFunctionCatalog.cs" Link="Shared/WindowsFunctionCatalog.cs" />
    <Compile Include="../../Repilot/Services/WindowsFunctionText.cs" Link="Shared/WindowsFunctionText.cs" />
    <!-- ActionSummary reads localized text; the stub serves the English resources. -->
    <Compile Include="../Shared/UiStrings.cs" Link="Shared/UiStrings.cs" />
    <None Include="../../Repilot/Strings/en-US/Resources.resw" Link="Resources.resw" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
